# Copy to .env for local development. On Cloud Run set these as env vars (see docs/engineering/architecture.md).
# No API key needed: Vertex AI and Web Risk use the Cloud Run service account, or locally
# `gcloud auth application-default login`. Never put keys in this file or in the front end.

# ---- Mode ----
# gemini          : real Vertex AI Gemini (required for demo, eval, submission)
# offline_fixture : keyword rules, no GCP. Every response says offline_fixture. Never demo or evaluate with it.
AGENT_MODE=offline_fixture
# webrisk : Google Cloud Web Risk API (enable webrisk.googleapis.com in the project)
# fixture : offline stand-in (hosts containing "phish" / "malware" count as listed)
URL_REPUTATION_BACKEND=fixture

# ---- Gemini (Vertex AI) ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Check the current Flash model id in Vertex AI Model Garden before the demo and pin it here.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0
# One Gemini call; past this the card is grey. Budget: 90% of warm requests <= 10 s.
GEMINI_TIMEOUT_S=9
# Retries on 429 / 5xx only, within GEMINI_TIMEOUT_S (0-2). Timeouts are never retried.
GEMINI_MAX_RETRIES=1

# ---- Web Risk ----
WEBRISK_TIMEOUT_S=3
# Links looked up per request; any link beyond this is "skipped" (card cannot be amber).
MAX_URLS_CHECKED=5

# ---- Input ----
MAX_INPUT_CHARS=5000
# Screenshot -> text module (app/screenshot.py). ON: boss decision 2026-09-24. false = no route, no upload button.
# offline_fixture returns a fixed sample text (no GCP); gemini mode reads the image with Gemini.
SCREENSHOT_ENABLED=true
MAX_IMAGE_MB=10

# ---- Cost ceiling ----
# Requests per hour for ALL clients together (in-memory, per instance). Over it: no Gemini / Web Risk call,
# card is grey unless the local domain check already found a red flag. Pair with the Gemini daily quota.
GLOBAL_RATE_LIMIT_PER_HOUR=120

# ---- FIN-SHIELD synthetic cases (separate from chat mode) ----
FINSHIELD_ENABLED=false
FINSHIELD_MODEL_MODE=offline_fixture
FINSHIELD_LIVE_CALLS_ENABLED=false
FINSHIELD_MODEL_CALL_CAP=0
FINSHIELD_BUDGET_ID=
# Exact origin, no trailing slash. Set to the actual HTTPS deployment URL.
FINSHIELD_ALLOWED_ORIGIN=
FINSHIELD_ALLOW_LOOPBACK_HTTP=false
# Firestore is required even for the hosted offline demonstration. No memory fallback.
FINSHIELD_FIRESTORE_PROJECT=
FINSHIELD_FIRESTORE_DATABASE=(default)
FINSHIELD_FIRESTORE_COLLECTION=finshield
# Durable global session creation ceiling per collection, no automatic reset.
# Each session can own only the two fixed templates; session expires after 24h.
# Expiry blocks access, it does not delete storage. Controller manages retention.
FINSHIELD_SESSION_CAP=100
# SHA256 hashes of separately held random reviewer access keys, never raw secrets.
FINSHIELD_REVIEWER_A_HASH=
FINSHIELD_REVIEWER_B_HASH=

# Required only on Vercel for keyless GCP federation; identifiers, never keys.
GCP_WORKLOAD_IDENTITY_AUDIENCE=
GCP_SERVICE_ACCOUNT_EMAIL=
